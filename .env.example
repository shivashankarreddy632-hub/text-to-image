# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your API key when available.

# 1. Google Gemini / Imagen API Key
# Sign up at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. OpenAI API Key (DALL-E 3)
# Sign up at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere

# 3. Stability AI Key (Stable Diffusion 3 / Core)
# Sign up at: https://platform.stability.ai/
STABILITY_API_KEY=sk-YourStabilityApiKeyHere

# 4. Hugging Face Access Token (FLUX / SDXL)
# Sign up at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YourHuggingFaceTokenHere

# Active Provider
DEFAULT_PROVIDER=gemini

